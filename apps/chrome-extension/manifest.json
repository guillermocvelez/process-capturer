{
  "manifest_version": 3,
  "name": "Process Capturer MVP",
  "version": "0.1.0",
  "description": "Captura flujos web y genera guías paso a paso.",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Process Capturer"
  }
}
